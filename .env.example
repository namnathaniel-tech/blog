# Copy to .env for running the prod Docker image locally. NEVER commit .env.
# In Railway/Render, set these as service variables instead.
SPRING_PROFILES_ACTIVE=prod
BLOG_SITE_NAME=My Project Blog
BLOG_SITE_DESCRIPTION=Notes and write-ups on things I build.
BLOG_BASE_URL=https://blog.example.com
ADMIN_EMAIL=you@example.com
BLOG_AUTHOR_NAME=Your Name
# >= 16 random chars, e.g. `openssl rand -base64 32`
IP_HASH_SALT=

# Neon Postgres (JDBC form, sslmode=require)
JDBC_DATABASE_URL=jdbc:postgresql://ep-xxx.neon.tech/blog?sslmode=require
JDBC_DATABASE_USERNAME=
JDBC_DATABASE_PASSWORD=

# Resend SMTP (https://resend.com/docs/send-with-smtp)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxx
MAIL_FROM=Blog <login@blog.example.com>

# --- Added in later phases (see docs/ARCHITECTURE.md#configuration) ---
# GUEST_COOKIE_SECRET=      # Phase 8, >= 32 random bytes, base64
# STORAGE_DRIVER=r2         # Phase 2 (local|r2)
# R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET= R2_PUBLIC_BASE_URL=
